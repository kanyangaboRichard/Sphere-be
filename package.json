  "main": "index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node -r reflect-metadata src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "typeorm": "ts-node -r reflect-metadata ./node_modules/typeorm/cli.js",
    "migration:generate": "npm run typeorm -- migration:generate -d src/Config/database.ts src/migrations/Init",
    "migration:run": "npm run typeorm -- migration:run -d src/Config/database.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/Config/database.ts"
  },
  "keywords": [],
